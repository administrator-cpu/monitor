# Copy to .env and edit. Every variable the backend reads is listed here (TRD section 9.1).
# Production: C:\Apps\command-center-deploy\apps\backend\.env, outside git, readable only by the
# account that runs monitor-api. The deploy never overwrites it. After editing it on the server:
#   pm2 restart monitor-api --update-env
# Invalid values stop startup and name the variable, never its value.
NODE_ENV=development

# Listener. Always bind to localhost; Nginx terminates TLS in front of it.
BIND_HOST=127.0.0.1
# The code default is 4000, but production and the deploy script's health check use 4111.
PORT_API=4111

# Exact frontend origin(s), comma separated. No wildcards.
# Development: the frontend's `pnpm dev:frontend` port. Production: https://monitor.thediv.in
ALLOWED_ORIGINS=http://localhost:3111

# Optional and currently unused (validated if set, reserved for signed cookies). 32+ random characters.
# COOKIE_SECRET=change-me-to-a-long-random-string-0123456789

# Defaults to true in production, false otherwise (so http://localhost works).
# Production refuses to start with COOKIE_SECURE=false.
# COOKIE_SECURE=true

# Defaults: C:\monitor\data\monitor.db and E:\monitor-logs on Windows,
# ./data/monitor.db and ./data/monitor-logs elsewhere.
# SQLITE_PATH=C:\monitor\data\monitor.db
# LOG_ROOT=E:\monitor-logs

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Path to an env file outside the repository. Used by the service and by CLI tools such as
# create-admin, so they read the same configuration as the running backend.
# CC_ENV_FILE=C:\Apps\command-center-deploy\apps\backend\.env

# --- Phase 3: PM2 and logs -------------------------------------------------
# Set to false where no PM2 daemon exists (development without PM2, tests).
# PM2_ENABLED=true
# The monitor reads PM2 through the same PM2_HOME as the account that runs your apps.
# PM2_HOME=C:\Users\Administrator\.pm2
# On by default in production: refuse to write logs onto the system / database volume.
# Set to false only for a single-disk test box.
# LOG_REQUIRE_SEPARATE_VOLUME=true

# --- Phase 4: alert email (Resend) ------------------------------------------
# Without a key the engine still runs and the dashboard shows alerts, but nothing is emailed.
# RESEND_API_KEY=re_xxxxxxxx
# Overrides the Resend endpoint. Tests and staging only.
# RESEND_API_URL=https://api.resend.com/emails
# ALERT_FROM=Command Center <alerts@your-domain.com>
# Base URL used for links inside emails (no trailing slash).
# PUBLIC_DASHBOARD_URL=https://monitor.thediv.in
# ALERT_FROM and PUBLIC_DASHBOARD_URL can also be changed in the dashboard
# (settings alert.from, alert.dashboard_url), which override these values.

# --- Phase 6: Nginx (all optional; each source is only used when set) ---------
# Must be an http:// URL on 127.0.0.1 or localhost.
# NGINX_STATUS_URL=http://127.0.0.1:8081/nginx_status
# NGINX_ACCESS_LOG=C:\nginx\logs\access.json.log
# NGINX_ERROR_LOG=C:\nginx\logs\error.log
# Hosts (optionally host:port) whose TLS certificate expiry is checked, comma separated.
# TLS_CHECK_HOSTS=monitor-api.thediv.in,monitor.thediv.in

# --- Phase 7: MongoDB (read-only monitoring user) ------------------------------
# MONGO_URI=mongodb://monitor:<password>@127.0.0.1:27017/admin?authSource=admin
# Databases whose system.profile is read for slow queries, comma separated.
# MONGO_PROFILE_DBS=app

# --- Phase 8: in-app agent ingest (loopback only) ------------------------------
# At least 24 characters. Without it the listener is not started.
# INGEST_TOKEN=change-me-to-a-long-random-token
# PORT_INGEST=4001

# --- Part 0: disks -------------------------------------------------------------
# Volumes to leave out of the disk list and the disk alerts, comma separated.
# Drive letters (D: or D) or absolute mount points. Optical drives are skipped automatically.
# DISK_EXCLUDE=D:

# --- Part A: GitHub code status (read-only) ------------------------------------
# Fine-grained, read-only token (Metadata, Contents, Pull requests, Actions: read).
# Without it the code card says "GitHub is not configured". A secret: never logged.
# GITHUB_TOKEN=github_pat_xxxxxxxx

# --- Part B: Resend delivery webhook ---------------------------------------------
# Signing secret of the endpoint https://monitor-api.thediv.in/webhooks/resend (starts with whsec_).
# Without it the webhook answers 503. A secret: never logged.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx

# Phase 11 (multi-host) adds no required variables; see docs/trd.md section 9.2.
