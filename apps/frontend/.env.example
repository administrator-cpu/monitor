# Copy to .env.local for development. This is the frontend's only setting.
# It is public (built into the browser bundle), not a secret, and is read at build time.
#
# Origin of the backend API, no trailing slash.
# Development: the backend's PORT_API from apps/backend/.env (4111 in the example).
# Production (Vercel): https://monitor-api.thediv.in
NEXT_PUBLIC_API_BASE=http://localhost:4111
