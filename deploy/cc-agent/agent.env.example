# /etc/cc-agent/agent.env  (owner root, mode 600). The Hosts page shows these lines with a fresh
# token when a host is added; this file is the reference (TRD 9.5).

# The monitor's API address (HTTPS).
CC_MONITOR_URL=https://monitor-api.thediv.in
# The name chosen on the Hosts page; for the logs only (the monitor knows the host from its token).
CC_HOST_NAME=ubuntu-acs
# One-time token from the Hosts page. Used once on the first start; the agent then keeps its own
# host token on its volume. Leave it in place: a restart does not use it again. To rotate or
# re-enroll, replace it with a new one and restart the agent.
CC_ENROLL_TOKEN=paste-the-token-from-the-Hosts-page
# Compose projects whose containers become services (the agent's own project is always included).
CC_PROJECTS=acs
# Mount points to report, comma separated.
CC_DISKS=/
# Remote start/stop/restart from the dashboard (M5). Off until then.
CC_ACTIONS=off
# Container logs (M3, agent 0.3.0): on by default. The line limit per container comes from the
# monitor (Settings, Remote hosts, 200 lines/s); a value here wins over it.
#CC_LOGS=on
#CC_LOG_LINES_PER_S=200
# Disk buffer on the agent's volume while the monitor is unreachable, in MB.
#CC_LOG_BUFFER_MB=50
